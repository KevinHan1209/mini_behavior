    "int_coef": 0.0,
    "ext_coef": 1.0,
    "int_gamma": 0.99,
    "update_proportion": 0.25
  },
  "env_config": {
    "env_id": "MiniGrid-MultiToy-8x8-N2-v0",
    "task": "MultiToy",
    "room_size": 8,
    "max_steps": 200
  },
  "wandb_config": {
    "project": "sb3-noveld-extrinsic",
    "group": "quick_smoke",
    "tags": ["sb3", "noveld", "extrinsic", "smoke"]
  }
}
